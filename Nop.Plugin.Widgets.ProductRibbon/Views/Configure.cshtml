@model ProductRibbonModel
@{
    Layout = "_ConfigurePlugin";
    var isEdit = Model.Id > 0;
    var ribbons = ViewBag.Ribbons as List<ProductRibbonModel> ?? new List<ProductRibbonModel>();
}

<form id="ribbon-form" asp-area="Admin" asp-controller="WidgetsProductRibbon" asp-action="@(isEdit ? "Edit" : "Create")" method="post">
    @Html.AntiForgeryToken()

    <div class="cards-group">
        <div class="card card-default">
            <div class="card-header">
                <i class="fas fa-tags"></i>
                @(isEdit ? "Etiketi Düzenle #" + Model.Id : "Yeni Ürün Etiketi Ekle")
            </div>
            <div class="card-body">
                <input type="hidden" asp-for="Id" />
                
                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="Text" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="Text" />
                        <span asp-validation-for="Text"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="BackgroundColor" />
                    </div>
                    <div class="col-md-9">
                        <input asp-for="BackgroundColor" type="color" class="form-control form-control-color" style="width: 80px; height: 38px;" />
                        <span asp-validation-for="BackgroundColor"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="TextColor" />
                    </div>
                    <div class="col-md-9">
                        <input asp-for="TextColor" type="color" class="form-control form-control-color" style="width: 80px; height: 38px;" />
                        <span asp-validation-for="TextColor"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="DisplayOrder" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="DisplayOrder" />
                        <span asp-validation-for="DisplayOrder"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="IsActive" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="IsActive" />
                        <span asp-validation-for="IsActive"></span>
                    </div>
                </div>

                @if (isEdit)
                {
                    <input type="hidden" asp-for="ProductSearchModel.ProductRibbonId" value="@Model.Id" />
                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <label class="col-form-label">Eşleşen Ürünler</label>
                                <div title="Bu etikete bağlı ürünler" class="ico-help"><i class="fas fa-question-circle"></i></div>
                            </div>
                        </div>
                        <div class="col-md-9">
                            <div class="card card-default card-outline">
                                <div class="card-body">
                                    @await Html.PartialAsync("Table", new DataTablesModel
                                    {
                                        Name = "mapped-products-grid",
                                        UrlRead = new DataUrl("ProductList", "WidgetsProductRibbon", new RouteValueDictionary { [nameof(Model.ProductSearchModel.ProductRibbonId)] = Model.Id }),
                                        UrlDelete = new DataUrl("ProductDelete", "WidgetsProductRibbon", new RouteValueDictionary { ["ribbonId"] = Model.Id }),
                                        BindColumnNameActionDelete = nameof(ProductRibbonProductModel.ProductId),
                                        Length = Model.ProductSearchModel.PageSize,
                                        LengthMenu = Model.ProductSearchModel.AvailablePageSizes,
                                        Filters = new List<FilterParameter>
                                        {
                                            new FilterParameter(nameof(Model.ProductSearchModel.ProductRibbonId))
                                        },
                                        ColumnCollection = new List<ColumnProperty>
                                        {
                                            new ColumnProperty(nameof(ProductRibbonProductModel.ProductName))
                                            {
                                                Title = T("Admin.Catalog.Products.Fields.Name").Text
                                            },
                                            new ColumnProperty(nameof(ProductRibbonProductModel.Published))
                                            {
                                                Title = T("Admin.Catalog.Products.Fields.Published").Text,
                                                Width = "100",
                                                ClassName = NopColumnClassDefaults.CenterAll,
                                                Render = new RenderBoolean()
                                            },
                                            new ColumnProperty(nameof(ProductRibbonProductModel.ProductId))
                                            {
                                                Title = T("Admin.Common.Delete").Text,
                                                Width = "100",
                                                Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                                                ClassName = NopColumnClassDefaults.Button
                                            }
                                        }
                                    })
                                </div>
                                <div class="card-footer">
                                    <button type="submit" id="btnAddNewProduct" onclick="javascript:OpenWindow('@(Url.Action("ProductAddPopup", "WidgetsProductRibbon", new { ribbonId = Model.Id, btnId = "btnRefreshProducts", formId = "ribbon-form" }))', 800, 800, true); return false;" class="btn btn-primary">
                                        <i class="fas fa-plus"></i> Ürün Ekle
                                    </button>
                                    <button type="submit" id="btnRefreshProducts" style="display: none"></button>
                                    <script>
                                        $(document).ready(function () {
                                            $('#btnRefreshProducts').click(function () {
                                                updateTable('#mapped-products-grid');
                                                return false;
                                            });
                                        });
                                    </script>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="form-group row">
                        <div class="col-md-3">
                            <div class="label-wrapper">
                                <label class="col-form-label">Eşleşen Ürünler</label>
                                <div title="Etiketi kaydettikten sonra ürün ekleyebilirsiniz" class="ico-help"><i class="fas fa-question-circle"></i></div>
                            </div>
                        </div>
                        <div class="col-md-9">
                            <div class="alert alert-info mb-0">
                                Etiketi kaydettikten sonra ürün ekleyebilirsiniz.
                            </div>
                        </div>
                    </div>
                }

                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="save" class="btn btn-primary">
                            <i class="fas fa-save"></i> @(isEdit ? "Güncelle" : "Kaydet")
                        </button>
                        @if (isEdit)
                        {
                            <a asp-area="Admin" asp-controller="WidgetsProductRibbon" asp-action="Configure" class="btn btn-secondary">
                                <i class="fas fa-times"></i> İptal
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<div class="card card-default mt-4">
    <div class="card-header">
        <i class="fas fa-list"></i> Mevcut Ürün Etiketleri
    </div>
    <div class="card-body">
        @if (ribbons.Any())
        {
            <table class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th>#ID</th>
                        <th>Önizleme</th>
                        <th>Etiket Metni</th>
                        <th>Arka Plan Rengi</th>
                        <th>Yazı Rengi</th>
                        <th>Sıra</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ribbons)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>
                                <span style="display:inline-block; padding:4px 8px; border-radius:4px; font-weight:bold; background-color:@item.BackgroundColor; color:@item.TextColor;">
                                    @item.Text
                                </span>
                            </td>
                            <td>@item.Text</td>
                            <td><code>@item.BackgroundColor</code></td>
                            <td><code>@item.TextColor</code></td>
                            <td>@item.DisplayOrder</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">Pasif</span>
                                }
                            </td>
                            <td>
                                <a asp-area="Admin" asp-controller="WidgetsProductRibbon" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                    <i class="fas fa-edit"></i> Düzenle
                                </a>
                                <form asp-area="Admin" asp-controller="WidgetsProductRibbon" asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline-block;" onsubmit="return confirm('Bu etiketi silmek istediğinizden emin misiniz?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i> Sil
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">
                Henüz kayıtlı bir ürün etiketi bulunmamaktadır.
            </div>
        }
    </div>
</div>
